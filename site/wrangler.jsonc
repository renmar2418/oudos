{
  // Cloudflare Workers Static Assets + API Worker for Oudos
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oudos-site",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
