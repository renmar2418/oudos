# Oudos Self-Hosting Configuration (AGPL-3.0 — zero paywalled features)
# Copy to .env (or deploy/.env) before running docker compose.

# Raw server domain displayed on Windows host consent cards (no https:// prefix).
OUD_SERVER_DOMAIN=localhost

# HTTP port exposing the web PWA console, /api/v1/*, and /ws/signal.
OUD_HTTP_PORT=8080

# Optional: Pin an explicit 64-hex-char Ed25519 seed (leave empty to auto-generate
# and persist /var/lib/oudos/server.key inside the oudos_data volume).
OUD_SERVER_SEED_HEX=

# WebRTC transport mode:
#   direct_p2p  (default, $0 cost, uses public STUN only)
#   coturn      (optional self-hosted TURN via `--profile coturn`)
#   cloudflare  (optional Cloudflare Realtime TURN free tier, 1,000 GB/month)
OUD_TURN_MODE=direct_p2p
OUD_STUN_URL=stun:stun.cloudflare.com:3478

# Optional self-hosted coturn settings (enable compose `--profile coturn`)
OUD_COTURN_HOST=
OUD_COTURN_PORT=3478
OUD_COTURN_TLS_PORT=5349
OUD_COTURN_SECRET=

# Optional Cloudflare Realtime TURN credentials (when OUD_TURN_MODE=cloudflare)
OUD_CF_TURN_TOKEN_ID=
OUD_CF_TURN_API_TOKEN=

# Logging verbosity (error | warn | info | debug)
RUST_LOG=info
