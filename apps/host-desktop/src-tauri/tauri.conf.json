{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oudos",
  "version": "0.1.0",
  "identifier": "org.oudos.host",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "consent",
        "title": "Oudos — Connection Request",
        "url": "index.html?view=consent",
        "width": 520,
        "height": 660,
        "resizable": false,
        "alwaysOnTop": true,
        "center": true,
        "visible": true,
        "theme": "Light"
      },
      {
        "label": "banner",
        "title": "Oudos — Active Session",
        "url": "index.html?view=banner",
        "width": 640,
        "height": 56,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "closable": false,
        "skipTaskbar": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "license": "AGPL-3.0-only"
  }
}
