# syntax=docker/dockerfile:1

FROM node:22-alpine AS builder
WORKDIR /src

RUN corepack enable

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps/web-pwa/package.json apps/web-pwa/package.json
COPY apps/host-desktop/package.json apps/host-desktop/package.json
COPY apps/mobile-capacitor/package.json apps/mobile-capacitor/package.json

RUN pnpm install --frozen-lockfile --filter @oudos/web-pwa...

COPY apps/web-pwa ./apps/web-pwa
RUN pnpm --filter @oudos/web-pwa build

FROM nginx:1.27-alpine AS runtime
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /src/apps/web-pwa/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/health >/dev/null 2>&1 || exit 1
