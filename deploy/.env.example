# Oudos Self-Hosting Configuration (AGPL-3.0 — zero paywalled features)
# Copy to deploy/.env (or pass `--env-file .env` from repo root).

OUD_SERVER_DOMAIN=localhost
OUD_HTTP_PORT=8080
OUD_SERVER_SEED_HEX=

# WebRTC transport mode: direct_p2p (default) | coturn | cloudflare
OUD_TURN_MODE=direct_p2p
OUD_STUN_URL=stun:stun.cloudflare.com:3478

# Optional self-hosted coturn (`docker compose --profile coturn up -d`)
OUD_COTURN_HOST=
OUD_COTURN_PORT=3478
OUD_COTURN_TLS_PORT=5349
OUD_COTURN_SECRET=

# Optional Cloudflare Realtime TURN (1,000 GB/month free tier)
OUD_CF_TURN_TOKEN_ID=
OUD_CF_TURN_API_TOKEN=

RUST_LOG=info
